{
  "name": "specter-blacksite",
  "private": true,
  "version": "5.18.0",
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "description": "Static SPECTER: Blacksite release verification and GitHub Pages packaging.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:textures:medium": "python scripts/build-medium-textures.py",
    "validate:release": "node scripts/release.mjs validate",
    "qa:graphics": "node scripts/graphics-qa.mjs",
    "qa:gameplay": "node scripts/gameplay-qa.mjs",
    "qa:runtime": "node scripts/runtime-acceptance.mjs",
    "qa:webgpu-advanced": "node scripts/webgpu-advanced-qa.mjs",
    "qa:webgpu-lab": "node scripts/webgpu-lab-qa.mjs",
    "qa:webgpu-temporal": "node scripts/webgpu-temporal-qa.mjs",
    "qa:webgpu-bvh": "node scripts/scene-bvh-proof-qa.mjs",
    "qa:fsr2-luminance": "node scripts/fsr2-luminance-first-mip-qa.mjs",
    "qa:webgpu-release": "node scripts/webgpu-release-qa.mjs",
    "qa:webgpu-lab-browser": "node scripts/webgpu-lab-browser-qa.mjs",
    "qa:webgpu": "pnpm run qa:webgpu-advanced && pnpm run qa:webgpu-lab && pnpm run qa:webgpu-temporal && pnpm run qa:webgpu-bvh && pnpm run qa:fsr2-luminance && pnpm run qa:webgpu-release",
    "qa:browser": "playwright test",
    "package:release": "node scripts/release.mjs package",
    "verify:release": "node scripts/release.mjs verify",
    "release:check": "npm run validate:release && npm run qa:graphics && npm run qa:gameplay && npm run qa:runtime && npm run qa:webgpu && npm run package:release && npm run verify:release"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "three": "0.166.1"
  }
}
